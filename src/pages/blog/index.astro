---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}
---

<Layout
  title="Blog - ElkaRec"
  description="Actualités, retours d'expérience et réflexions sur l'audiovisuel, le streaming et l'éco-conception."
  image="/elkast.webp"
>
  <Header />

  <main class="pt-24 pb-20">
    <!-- Hero Section -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 text-red-500">Blog</h1>
        <p class="text-xl text-zinc-400">
          Actualités, retours d'expérience et réflexions sur l'audiovisuel
        </p>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="container mx-auto px-6 py-12">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="bg-zinc-900 rounded-xl border border-zinc-800 overflow-hidden hover:border-red-500/50 transition-all group">
              <a href={`/blog/${post.slug}`} class="block">
                {/* Image */}
                <div class="aspect-video overflow-hidden bg-zinc-800">
                  {post.data.image ? (
                    <Image
                      src={post.data.image}
                      alt={post.data.title}
                      width={800}
                      height={450}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-gradient-to-br from-red-900/30 to-zinc-900 flex items-center justify-center">
                      <svg class="w-12 h-12 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                      </svg>
                    </div>
                  )}
                </div>

                {/* Content */}
                <div class="p-6">
                  <div class="flex items-center gap-3 mb-3">
                <time class="text-sm text-zinc-500" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
                </time>

                    {post.data.tags?.[0] && (
                      <span class="text-xs px-2 py-1 bg-red-500/10 text-red-400 rounded-full border border-red-500/20">
                        {post.data.tags[0]}
                      </span>
                    )}
                  </div>

                  <h2 class="text-xl font-bold text-white mb-3 group-hover:text-red-400 transition-colors">
                    {post.data.title}
                  </h2>

                  <p class="text-zinc-400 text-sm leading-relaxed line-clamp-3">
                    {post.data.description}
                  </p>

                  <div class="mt-4 flex items-center gap-2 text-red-400 text-sm font-medium">
                    Lire l'article
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>

        {posts.length === 0 && (
          <div class="text-center py-20">
            <p class="text-zinc-500 text-lg">Aucun article pour le moment. Revenez bientôt !</p>
          </div>
        )}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center bg-gradient-to-br from-red-900/20 to-zinc-900/50 p-12 rounded-2xl border border-red-500/20">
        <h2 class="text-3xl font-bold text-white mb-4">Envie de collaborer ?</h2>
        <p class="text-zinc-300 mb-8">
          Discutons de vos projets audiovisuels
        </p>
        <a href="/contact"
           class="inline-block px-8 py-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg transition-all transform hover:scale-105">
          Nous contacter
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
