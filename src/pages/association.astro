---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import collectif from '../assets/images/collectif.webp';
import repair from '../assets/images/01v-repair.webp';

// Page destinée au public « membres et bénévoles », pas aux clients.
// Un public par page, un appel à l'action par page : celui d'ici est
// « Venir au local », jamais « Demander un devis ». Voir le §0 bis du brief
// Homelab\Mission_ElkaRec_Contenu.md.

const faq = [
  {
    q: "ElkaRec est-elle une association loi 1901 ?",
    r: "Oui. ElkaRec Audiovisuel Event est une association loi 1901 à but non lucratif, déclarée en préfecture et immatriculée au répertoire Sirene. Nos factures ne portent donc pas de TVA, et nos tarifs couvrent nos coûts sans marge.",
  },
  {
    q: "Qu'est-ce qu'une association collégiale ?",
    r: "C'est une association qui fonctionne sans président, sans trésorier et sans bureau. Les décisions sont prises ensemble, par consentement : une proposition passe quand elle ne rencontre ni veto ni opposition forte. Les responsabilités et la représentation de l'association sont partagées entre les membres.",
  },
  {
    q: "D'où vient le matériel d'ElkaRec ?",
    r: "De deux sources. Des entreprises de l'audiovisuel nous ont confié du matériel décommissionné, notamment Eurosport, Canal+, L'Équipe, Videlio et Midi Libre. Le reste vient d'enchères industrielles. Tout est remis en service par des bénévoles techniciens.",
  },
  {
    q: "Peut-on devenir bénévole chez ElkaRec ?",
    r: "Oui. Donner un coup de main sur une captation, participer à la remise en service du matériel ou venir apprendre à s'en servir ne demande aucune adhésion préalable. Le plus simple est de nous écrire pour convenir d'un passage au local d'Antony.",
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://elkarec.fr/' },
      { '@type': 'ListItem', position: 2, name: "L'association", item: 'https://elkarec.fr/association' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.r },
    })),
  },
];
---

<Layout
  title="L'association ElkaRec - audiovisuel collégial à Antony (92)"
  description="Association audiovisuelle loi 1901 collégiale à Antony (92). Des bénévoles qui remettent en service du matériel de diffusion professionnelle."
  image="/concert.webp"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-24">

    <!-- Accroche -->
    <section class="py-16 md:py-24">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <span class="text-red-500 font-semibold text-sm uppercase tracking-wider">
            L'association
          </span>
          <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-6 leading-tight">
            Une association audiovisuelle collégiale, à Antony
          </h1>
          <p class="text-xl text-zinc-300 leading-relaxed">
            Des techniciens de l'audiovisuel qui remettent en service du
            matériel de diffusion professionnelle et le mettent au service
            d'événements qui n'y auraient pas accès autrement.
          </p>
        </div>
      </div>
    </section>

    <!-- Collégialité -->
    <section class="py-16 bg-zinc-900/50">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
            <div>
              <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                Pas de président, pas de bureau
              </h2>
              <p class="text-lg text-zinc-300 leading-relaxed mb-5">
                ElkaRec fonctionne en collégialité intégrale. Il n'y a ni
                président, ni trésorier statutaire, ni conseil
                d'administration. Les décisions se prennent ensemble, par
                consentement : une proposition passe quand elle ne rencontre
                ni veto ni opposition forte.
              </p>
              <p class="text-lg text-zinc-300 leading-relaxed mb-5">
                Ce n'est pas une posture, c'est écrit dans nos statuts. Les
                responsabilités sont partagées, et les membres qui ont un
                intérêt personnel dans une décision ne votent pas dessus.
              </p>
              <p class="text-lg text-zinc-300 leading-relaxed">
                Concrètement, cela veut dire qu'une personne qui rejoint
                l'association pèse réellement sur ce qu'elle devient, au lieu
                d'exécuter les choix d'un bureau.
              </p>
            </div>
            <div class="bg-zinc-900 rounded-xl border border-zinc-800 overflow-hidden hover:border-red-500/50 transition-all group">
              <Image
                src={collectif}
                alt="Les bénévoles d'ElkaRec en régie lors d'une captation"
                width={800}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Le récit du parc -->
    <section class="py-16 md:py-24">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
            <div class="order-2 lg:order-1 bg-zinc-900 rounded-xl border border-zinc-800 overflow-hidden hover:border-red-500/50 transition-all group">
              <Image
                src={repair}
                alt="Remise en service de matériel de diffusion dans le local d'Antony"
                width={800}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="order-1 lg:order-2">
              <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                Du matériel de chaîne, remis en service
              </h2>
              <p class="text-lg text-zinc-300 leading-relaxed mb-5">
                Quand une chaîne de télévision renouvelle sa régie, le
                matériel sortant part souvent à la benne alors qu'il
                fonctionne encore parfaitement. C'est ce matériel-là que nous
                récupérons, testons, réparons et remettons en exploitation.
              </p>
              <p class="text-lg text-zinc-300 leading-relaxed mb-5">
                Le parc vient de deux sources : des entreprises de
                l'audiovisuel qui nous ont confié leur matériel
                décommissionné, et des enchères industrielles. Matrices de
                brassage 20×20 et 32×32, six caméras, système de ralenti,
                streaming SRT et NDI, régie vMix et TriCaster.
              </p>
              <p class="text-lg text-zinc-300 leading-relaxed">
                Le résultat est un niveau d'équipement que très peu
                d'associations atteignent, et que nous pouvons mettre à
                disposition d'événements associatifs, municipaux ou culturels
                qui n'auraient jamais les moyens de le louer.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Upcycling : la mission -->
    <section class="py-16 bg-zinc-900/50">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
            Le réemploi comme méthode
          </h2>
          <p class="text-lg text-zinc-300 leading-relaxed mb-5">
            Remettre en service plutôt que racheter n'est pas seulement une
            contrainte de budget, c'est une position. Un mélangeur de
            production ou une matrice de brassage dure vingt ans ; leur
            remplacement au bout de cinq ans relève du cycle commercial, pas
            de l'usure.
          </p>
          <p class="text-lg text-zinc-300 leading-relaxed mb-5">
            Chaque équipement récupéré demande un diagnostic, souvent une
            réparation, parfois la fabrication d'une pièce ou d'un adaptateur.
            C'est un travail technique réel, et c'est aussi la meilleure
            école : on comprend une régie bien mieux en la réparant qu'en
            l'achetant.
          </p>
          <p class="text-lg text-zinc-300 leading-relaxed">
            <a href="/local" class="text-red-500 hover:text-red-400 underline underline-offset-4 transition-colors">
              Le local d'Antony
            </a>
            est l'endroit où ce travail se fait, et il est ouvert à qui veut
            y participer.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 md:py-24">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center">
            Questions fréquentes
          </h2>
          <div class="space-y-4">
            {faq.map((item) => (
              <details class="group bg-zinc-900 rounded-xl border border-zinc-800 hover:border-red-500/40 transition-all">
                <summary class="cursor-pointer list-none p-6 flex items-center justify-between gap-4 text-white font-semibold">
                  <span>{item.q}</span>
                  <svg class="w-5 h-5 flex-none text-red-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="px-6 pb-6 text-zinc-400 leading-relaxed">{item.r}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Appel à l'action : venir, pas acheter -->
    <section class="py-20 bg-gradient-to-br from-red-900/20 to-zinc-950">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
            Envie de voir à quoi ça ressemble ?
          </h2>
          <p class="text-xl text-zinc-300 mb-8 leading-relaxed">
            Le plus simple est de passer au local. Écrivez-nous, nous
            convenons d'un moment.
          </p>
          <a href="/local"
             class="inline-block px-8 py-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg transition-all transform hover:scale-105">
            Venir au local
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
