---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';

// Une URL par réalisation. Elles vivaient toutes sur /realisations, qui
// devait donc se classer seule sur des requêtes sans rapport entre elles
// (captation de skateboard dans l'Essonne, sonorisation de fête de village
// dans le Gers…). Une page ne se classe bien que sur un sujet : chaque
// réalisation a désormais le sien. /realisations reste la page pivot.
export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => data.type === 'realisation');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Trois autres réalisations en pied de page : sans elles, chaque fiche
// serait un cul-de-sac, atteignable seulement depuis la page liste.
const autres = (await getCollection('projects', ({ data: d }) => d.type === 'realisation'))
  .filter((e) => e.slug !== entry.slug)
  .sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0))
  .slice(0, 3);

const url = `https://elkarec.fr/realisations/${entry.slug}/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://elkarec.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Réalisations', item: 'https://elkarec.fr/realisations/' },
    { '@type': 'ListItem', position: 3, name: data.title, item: url },
  ],
};
---

<Layout
  title={`${data.title} - réalisation ElkaRec`}
  description={data.description}
  schema={schema}
>
  <Header />

  <main id="main-content">
    <section class="container mx-auto px-6 pt-32 pb-12">
      <div class="max-w-4xl mx-auto">
        <nav aria-label="Fil d'Ariane" class="text-sm text-zinc-500 mb-8">
          <a href="/" class="hover:text-red-400 transition-colors">Accueil</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <a href="/realisations/" class="hover:text-red-400 transition-colors">Réalisations</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <span class="text-zinc-400">{data.title}</span>
        </nav>

        <span class="text-red-500 text-xs font-semibold uppercase tracking-wider">
          {data.category}
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-4">{data.title}</h1>

        {(data.periode || data.lieu) && (
          <p class="text-zinc-400">
            {data.date ? (
              <time datetime={data.date.toISOString().slice(0, 10)}>{data.periode}</time>
            ) : (
              data.periode
            )}
            {data.periode && data.lieu ? ' · ' : ''}
            {data.lieu}
          </p>
        )}
      </div>
    </section>

    <section class="container mx-auto px-6 pb-16">
      <div class="max-w-4xl mx-auto">
        {data.image && (
          <div class="aspect-[21/9] overflow-hidden rounded-2xl border border-zinc-800 bg-gradient-to-br from-red-900/30 to-zinc-900 mb-10">
            <Image
              src={data.image}
              alt={data.title}
              width={1400}
              height={600}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        )}

        <div class="prose prose-invert prose-zinc max-w-none prose-p:text-zinc-300 prose-p:leading-relaxed prose-p:text-justify">
          <Content />
        </div>

        {data.chiffres && (
          <div class="flex flex-wrap gap-4 mt-10">
            {data.chiffres.map((c) => (
              <div class="flex-1 min-w-[200px] bg-zinc-900 rounded-xl border border-zinc-800 p-6">
                <p class="text-4xl font-bold text-red-500">{c.valeur}</p>
                <p class="text-zinc-400 text-sm mt-1">{c.label}</p>
              </div>
            ))}
          </div>
        )}

        {(data.porteur || data.diffuseur) && (
          <div class="flex flex-wrap gap-4 mt-6">
            {data.porteur && (
              <div class="flex-1 min-w-[220px] bg-zinc-900 rounded-xl border border-zinc-800 p-6">
                <h2 class="text-white font-semibold text-sm uppercase tracking-wider mb-2">
                  Projet porté par
                </h2>
                <p class="text-zinc-400 text-sm leading-relaxed">{data.porteur}</p>
              </div>
            )}

            {data.diffuseur && (
              <div class="flex-1 min-w-[220px] bg-zinc-900 rounded-xl border border-zinc-800 p-6">
                <h2 class="text-white font-semibold text-sm uppercase tracking-wider mb-2">
                  Diffusion
                </h2>
                <p class="text-zinc-400 text-sm">{data.diffuseur}</p>
              </div>
            )}
          </div>
        )}

        {data.prestations && (
          <div class="bg-zinc-900 rounded-xl border border-zinc-800 p-6 md:p-8 mt-6">
            <h2 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">
              Ce que nous avons assuré
            </h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2">
              {data.prestations.map((presta) => (
                <li class="text-zinc-400 text-sm flex gap-2">
                  <span class="text-red-500/70 shrink-0" aria-hidden="true">›</span>
                  <span>{presta}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {data.liens && (
          <div class="mt-8 flex flex-wrap gap-3">
            {data.liens.map((lien) => (
              <a
                href={lien.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-red-500/50 text-white text-sm font-semibold px-5 py-3 rounded-lg transition-all"
              >
                {lien.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )}

        <div class="mt-12 pt-8 border-t border-zinc-800 flex flex-wrap gap-4">
          <a href="/contact/" class="bg-red-600 hover:bg-red-500 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
            Demander un devis
          </a>
          <a href="/realisations/" class="border border-zinc-700 hover:border-red-500/50 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
            Toutes nos réalisations
          </a>
        </div>
      </div>
    </section>

    <section class="container mx-auto px-6 pb-20">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-6">Autres réalisations</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {autres.map((a) => (
            <a
              href={`/realisations/${a.slug}/`}
              class="group bg-zinc-900 rounded-xl border border-zinc-800 hover:border-red-500/50 transition-all p-6"
            >
              <span class="text-red-500 text-xs font-semibold uppercase tracking-wider">
                {a.data.category}
              </span>
              <h3 class="text-white font-bold mt-2 group-hover:text-red-400 transition-colors">
                {a.data.title}
              </h3>
              {a.data.ville && <p class="text-zinc-500 text-xs mt-1">{a.data.ville}</p>}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
