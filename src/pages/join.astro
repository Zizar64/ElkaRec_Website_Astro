---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// PAGE PRÉPARÉE, VOLONTAIREMENT HORS LIGNE.
//
// Elle n'est liée depuis aucune navigation, elle est en noindex et elle est
// exclue du sitemap (voir le filtre dans astro.config.mjs).
//
// Raison : en l'état des statuts, l'article 14 fait de CHAQUE membre adhérent
// un membre de la direction collégiale. Ouvrir les adhésions aujourd'hui
// reviendrait à faire de chaque nouveau venu un co-dirigeant engageant sa
// responsabilité personnelle. La catégorie « membre usager » est le verrou, et
// le texte de la modification est déjà rédigé dans le dossier d'AGE.
//
// Les statuts consolidés du 2026-08-16 ne changent que l'article 3 (l'adresse) :
// le blocage tient toujours. Ne mettre en ligne (navigation + sitemap + index +
// lien de paiement) qu'après feu vert explicite de Lucas, AGE tenue.
//
// Source de la grille : 02_ELKAREC\02_MEMBRES_ET_LOCAL\Chantier_5_local_produit.html
const formules = [
  {
    nom: 'Soutien',
    montant: '30 €',
    periode: '/ an',
    mise_en_avant: false,
    avantages: [
      'Accès libre à la permanence hebdomadaire',
      'Ateliers gratuits',
      'Invitation aux prestations en tant qu\'observateur',
    ],
    pour_qui: 'Pour qui veut soutenir et passer de temps en temps.',
  },
  {
    nom: 'Usager',
    montant: '90 €',
    periode: '/ an',
    mise_en_avant: true,
    avantages: [
      'Tout le niveau Soutien',
      'Accès distant au parc technique : un espace de stockage et une machine de montage et d\'étalonnage accessibles de chez vous',
      'Emprunt de matériel, sous caution',
      'Plateau au tarif adhérent',
      'Priorité sur les prestations rémunérées',
    ],
    pour_qui: 'La formule de référence.',
  },
  {
    nom: 'Adhérent',
    montant: 'Cooptation',
    periode: '',
    mise_en_avant: false,
    avantages: [
      'Tout le niveau Usager',
      'Voix délibérative',
      'Membre de la direction collégiale',
      'Cotisation fixée par le collège',
    ],
    pour_qui: 'Sur cooptation uniquement, après un an d\'usage. Engage la responsabilité, d\'où le filtre.',
  },
];
---

<Layout
  title="Adhérer - ElkaRec"
  description="Les formules d'adhésion à ElkaRec, association audiovisuelle et événementielle installée à Antony (92)."
  noindex={true}
>
  <Header />

  <main id="main-content" class="pt-24 pb-20">
    <!-- Hero Section -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 text-red-500">
          Adhérer
        </h1>
        <p class="text-xl text-zinc-400">
          Rejoindre une association collégiale, son local d'Antony et son parc technique
        </p>
      </div>
    </section>

    {/* Avertissement affiché : la page est accessible par URL directe même si
        elle n'est liée nulle part. Tant que l'AGE n'a pas modifié l'article 14,
        aucune adhésion ne doit pouvoir être souscrite depuis le site. */}
    <section class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto bg-red-500/10 border border-red-500/40 rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-white mb-3">Les adhésions ne sont pas encore ouvertes</h2>
        <p class="text-zinc-300 leading-relaxed">
          Cette grille est en préparation et sera ouverte après notre assemblée
          générale extraordinaire. En attendant, aucune adhésion ne peut être
          souscrite. Si le projet vous intéresse,
          <a href="/contact/" class="text-red-400 hover:text-red-300 underline underline-offset-4 transition-colors">écrivez-nous</a>
          et nous vous préviendrons de l'ouverture.
        </p>
      </div>
    </section>

    <!-- Grille d'adhésion -->
    <section class="container mx-auto px-6 py-12">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
          {formules.map((formule) => (
            <div
              class={`flex flex-col p-8 rounded-2xl border transition-all ${
                formule.mise_en_avant
                  ? 'bg-gradient-to-br from-red-900/30 to-zinc-900/50 border-red-500/50'
                  : 'bg-gradient-to-br from-zinc-900 to-zinc-900/50 border-zinc-800'
              }`}
            >
              <h2 class="text-2xl font-bold text-white mb-2">{formule.nom}</h2>
              <p class="mb-6">
                <span class="text-3xl font-bold text-red-500">{formule.montant}</span>
                {formule.periode && (
                  <span class="text-zinc-400 text-sm ml-1">{formule.periode}</span>
                )}
              </p>
              <ul class="space-y-3 mb-6 flex-1">
                {formule.avantages.map((avantage) => (
                  <li class="flex items-start gap-3 text-zinc-300 text-sm leading-relaxed">
                    <span class="mt-1.5 w-1.5 h-1.5 bg-red-400 rounded-full flex-shrink-0"></span>
                    <span>{avantage}</span>
                  </li>
                ))}
              </ul>
              <p class="text-sm text-zinc-500 italic">{formule.pour_qui}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Ce que l'adhésion finance -->
    <section class="container mx-auto px-6 py-12">
      <div class="max-w-4xl mx-auto bg-zinc-900 p-10 rounded-2xl border border-zinc-800">
        <h2 class="text-3xl font-bold text-white mb-6">Ce que ça veut dire concrètement</h2>
        <p class="text-lg text-zinc-300 leading-relaxed mb-4">
          ElkaRec fonctionne sans président ni bureau traditionnel : les membres
          partagent les responsabilités et les décisions se prennent ensemble.
        </p>
        <p class="text-lg text-zinc-300 leading-relaxed mb-4">
          Adhérer donne accès à la permanence hebdomadaire au local d'Antony, aux
          ateliers, et pour la formule Usager à un espace de stockage et à une
          machine de montage et d'étalonnage accessibles à distance, avec le
          matériel de dérushage déjà installé.
        </p>
        <p class="text-lg text-zinc-300 leading-relaxed">
          Les cotisations ne financent pas le local à elles seules, et ce n'est
          pas leur rôle : elles font vivre l'association entre deux prestations.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center bg-gradient-to-br from-red-900/20 to-zinc-900/50 p-12 rounded-2xl border border-red-500/20">
        <h2 class="text-3xl font-bold text-white mb-4">Envie d'en être ?</h2>
        <p class="text-zinc-300 mb-8">
          Écrivez-nous : nous vous préviendrons dès l'ouverture des adhésions.
        </p>
        <a href="/contact/"
           class="inline-block px-8 py-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg transition-all transform hover:scale-105">
          Nous écrire
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
