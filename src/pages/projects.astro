---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0)
);
---

<Layout
  title="Projets - ElkaRec"
  description="Découvrez nos projets audiovisuels et événementiels : ELKAST, régies mobiles, formations IP, et plus encore."
>
  <Header />

  <main class="pt-24 pb-20">
    <!-- Hero Section -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 text-red-500">
          Nos projets
        </h1>
        <p class="text-xl text-zinc-400">
          Découvrez quelques-uns des projets que nous avons accompagnés ou réalisés
        </p>
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="container mx-auto px-6 py-12">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((project) => (
            <article class="bg-zinc-900 rounded-xl border border-zinc-800 overflow-hidden hover:border-red-500/50 transition-all group">
              {/* Project Image */}
              <div class="aspect-video overflow-hidden bg-gradient-to-br from-red-900/30 to-zinc-900">
                {project.data.image ? (
                  <Image
                    src={project.data.image}
                    alt={project.data.title}
                    width={800}
                    height={450}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-16 h-16 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
              </div>

              {/* Content */}
              <div class="p-6">
                <h2 class="text-xl font-bold text-white mb-3 group-hover:text-red-400 transition-colors">
                  {project.data.title}
                </h2>

                {project.data.description && (
                  <p class="text-zinc-400 text-sm leading-relaxed line-clamp-3 mb-4">
                    {project.data.description}
                  </p>
                )}

                {project.data.tags && project.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {project.data.tags.map((tag: string) => (
                      <span class="text-xs px-2 py-1 bg-red-500/10 text-red-400 rounded-full border border-red-500/20">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Compétences -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-white mb-8 text-center">Nos compétences</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800">
            <h3 class="text-lg font-bold text-white mb-4">Vidéo & Streaming</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Captation multicam
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Streaming live
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Post-production
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Motion design
              </li>
            </ul>
          </div>

          <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800">
            <h3 class="text-lg font-bold text-white mb-4">Son & Audio</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Sonorisation live
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Mixage studio
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Prise de son
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Design sonore
              </li>
            </ul>
          </div>

          <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800">
            <h3 class="text-lg font-bold text-white mb-4">Lumière & Vidéo</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Conception lumière
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Éclairage automatisé
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Mapping vidéo
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Projection grand format
              </li>
            </ul>
          </div>

          <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800">
            <h3 class="text-lg font-bold text-white mb-4">IT & Infrastructure</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Réseaux événementiels
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Interconnexions IP
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Solutions cloud & edge
              </li>
              <li class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-red-400 rounded-full"></div>
                Monitoring & supervision
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center bg-gradient-to-br from-red-900/20 to-zinc-900/50 p-12 rounded-2xl border border-red-500/20">
        <h2 class="text-3xl font-bold text-white mb-4">Un projet similaire ?</h2>
        <p class="text-zinc-300 mb-8">
          Discutons de vos besoins et voyons comment nous pouvons vous accompagner
        </p>
        <a href="/contact"
           class="inline-block px-8 py-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg transition-all transform hover:scale-105">
          Nous contacter
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
