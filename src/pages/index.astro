---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import collectif from '../assets/images/collectif.webp';

import logoamp from '../assets/images/logoamp.webp';
import logocanal from '../assets/images/logocanal.webp';
import logoeurosport from '../assets/images/logoeurosport.webp';
import logovidelio from '../assets/images/logovidelio.webp';
import logoequipe from '../assets/images/logoequipe.webp';
import logoixi from '../assets/images/logoixi.webp';

// Références validées avec Lucas le 2026-08-13. L'ordre est imposé :
// Farn'High en tête, c'est la seule prestation facturée, payée et reconduite.
const references = [
  {
    nom: "Farn'High 2026",
    detail: "Captation et sonorisation, trois techniciens sur une journée. Prestation facturée, et le client reconduit en 2027.",
  },
  {
    nom: 'La Ride Divine',
    detail: 'Événement produit avec la ville de Tournefeuille.',
  },
  {
    nom: 'Comité des fêtes de Soumoulou',
    detail: "Captation et sonorisation d'événement municipal.",
  },
  {
    nom: 'La Dame de Canton',
    detail: 'Captation de concert.',
  },
  {
    nom: 'Les Nouveaux Sauvages',
    detail: 'Captation de concert.',
  },
  {
    nom: 'Antonime',
    detail: "Régie complète : topologie audio, plan de diffusion, schémas d'implantation.",
  },
  {
    nom: 'Téléthon Gaming',
    detail: 'Streaming multicaméra sur une opération caritative.',
  },
];
---

<Layout
  title="Captation vidéo et sonorisation à Antony (92) - ElkaRec"
  description="Association audiovisuelle et événementielle installée à Antony (92). Captation multicaméra, streaming et sonorisation d'événements. Devis sous 48 heures."
  image="/concert.webp"
>
  <Header />

  <main id="main-content">
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
    <!-- Background gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-red-900/20 via-zinc-950 to-zinc-950"></div>

    <!-- Animated background elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-red-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 text-red-500 leading-tight">
          Du matériel de chaîne, une équipe qui sait s'en servir, à côté de chez vous
        </h1>
        <p class="text-xl md:text-2xl text-zinc-300 mb-12 leading-relaxed">
          Association audiovisuelle et événementielle, installée à Antony (92)
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact"
             class="px-8 py-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg transition-all transform hover:scale-105">
            Demander un devis
          </a>
          <a href="/services"
             class="px-8 py-4 bg-zinc-800 hover:bg-zinc-700 text-white font-semibold rounded-lg transition-all border border-zinc-700">
            Nos offres et nos tarifs
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Bloc de preuve -->
  <section class="py-20 bg-zinc-900/50">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl font-bold text-center mb-16 text-white">Ce que nous avons fait</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {references.map((ref) => (
            <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 hover:border-red-500/50 transition-all">
              <h3 class="text-lg font-bold text-white mb-2">{ref.nom}</h3>
              <p class="text-zinc-400 leading-relaxed">{ref.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Le parc, et d'où il vient -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold text-white mb-8 text-center">Notre parc</h2>
        <p class="text-lg text-zinc-300 leading-relaxed">
          Notre parc vient de matériel de diffusion professionnelle confié par
          Eurosport, Canal+, L'Équipe, Videlio et Midi Libre, et d'enchères
          industrielles : matrices de brassage 20×20 et 32×32, six caméras, système de
          ralenti, streaming SRT et NDI, régie vMix et TriCaster. Du matériel de
          diffusion nationale, remis en service par des bénévoles.
        </p>
      </div>
    </div>
  </section>

  <!-- Qui nous sommes -->
  <section class="py-20 bg-zinc-900/50">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl font-bold text-white mb-12 text-center">Qui nous sommes</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <p class="text-lg text-zinc-300 leading-relaxed mb-6">
              ElkaRec est une association loi 1901 collégiale : pas de président,
              pas de conseil d'administration, pas de bureau traditionnel. Les
              membres partagent les responsabilités et les décisions importantes
              se prennent ensemble.
            </p>
            <p class="text-lg text-zinc-300 leading-relaxed mb-6">
              Ce sont des techniciens de l'audiovisuel qui donnent de leur temps
              pour remettre en service du matériel de diffusion professionnelle et
              le mettre au service d'événements qui n'y auraient pas accès
              autrement.
            </p>
            <p class="text-lg text-zinc-300 leading-relaxed">
              Nous intervenons depuis Antony, dans les Hauts-de-Seine, et plus
              largement en Île-de-France et partout où un projet le justifie.
            </p>
          </div>
          <div class="bg-zinc-900 rounded-xl border border-zinc-800 overflow-hidden hover:border-red-500/50 transition-all group">
            <Image
              src={collectif}
              alt="Notre équipe de bénévoles"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section « Ils nous ont aidé », transférée depuis /about lors de la
      fusion des pages.

      Formulation juridiquement calibrée : ces entreprises ont CONFIÉ du
      matériel décommissionné. Ne jamais écrire « ils nous font confiance »,
      « nos partenaires » ou « en partenariat avec » : citer la provenance
      d'un matériel est licite, suggérer un cautionnement commercial qui
      n'existe pas ne l'est pas. */}
  <section class="py-20 border-t border-zinc-800">
    <div class="container mx-auto px-6">

      <!-- Titre -->
      <div class="text-center mb-16">
        <span class="text-red-500 font-semibold text-sm uppercase tracking-wider">
          Partenaires Upcycling
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-3 mb-4">
          Ils nous ont aidé
        </h2>
        <p class="text-zinc-400 max-w-2xl mx-auto leading-relaxed">
          Ces entreprises nous ont confié leur matériel décommissionné,
          contribuant à notre mission d'upcycling et de réemploi technologique.
        </p>
      </div>

      <!-- Grille de logos -->
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-8 items-center max-w-4xl mx-auto">

        <div class="group flex items-center justify-center p-6 rounded-xl bg-zinc-800/30 border border-zinc-800 hover:border-red-500/30 transition-all duration-300 overflow-hidden">
          <Image
            src={logocanal}
            alt="Canal+"
            width={200}
            height={150}
            class="rounded-lg object-contain max-w-full group-hover:scale-110 transition-all duration-300"
          />
        </div>

        <div class="group flex items-center justify-center p-6 rounded-xl bg-zinc-800/30 border border-zinc-800 hover:border-red-500/30 transition-all duration-300">
          <Image
            src={logoeurosport}
            alt="Eurosport"
            width={200}
            height={150}
            class="rounded-lg object-contain max-w-full group-hover:scale-110 transition-all duration-300"
          />
        </div>

        <div class="group flex items-center justify-center p-6 rounded-xl bg-zinc-800/30 border border-zinc-800 hover:border-red-500/30 transition-all duration-300">
          <Image
            src={logovidelio}
            alt="Videlio"
            width={200}
            height={150}
            class="rounded-lg object-contain max-w-full group-hover:scale-110 transition-all duration-300"
          />
        </div>

        <div class="group flex items-center justify-center p-6 rounded-xl bg-zinc-800/30 border border-zinc-800 hover:border-red-500/30 transition-all duration-300">
          <Image
            src={logoequipe}
            alt="L'Equipe TV"
            width={200}
            height={150}
            class="rounded-lg object-contain max-w-full group-hover:scale-110 transition-all duration-300"
          />
        </div>

        <div class="group flex items-center justify-center p-6 rounded-xl bg-zinc-800/30 border border-zinc-800 hover:border-red-500/30 transition-all duration-300">
          <Image
            src={logoamp}
            alt="AMP Visual TV"
            width={200}
            height={150}
            class="rounded-lg object-contain max-w-full group-hover:scale-110 transition-all duration-300"
          />
        </div>

        <div class="group flex items-center justify-center p-6 rounded-xl bg-zinc-800/30 border border-zinc-800 hover:border-red-500/30 transition-all duration-300">
          <Image
            src={logoixi}
            alt="IXI Live"
            width={100}
            height={80}
            class="rounded-lg object-contain max-w-full group-hover:scale-110 transition-all duration-300"
          />
        </div>

        {/* Midi Libre est cité en texte : il n'existe pas de logo Midi Libre
            dans src/assets/images/. Ne pas en récupérer un sur le web. Si Lucas
            fournit l'asset, ajouter une carte sur le modèle ci-dessus. */}

      </div>

      <p class="text-center text-zinc-400 text-sm mt-10 max-w-2xl mx-auto">
        Midi Libre nous a également confié du matériel décommissionné.
      </p>

      <!-- Note en bas -->
      <p class="text-center text-zinc-500 text-sm mt-6">
        Votre entreprise souhaite contribuer ?
        <a href="/contact" class="text-red-500 hover:text-red-400 underline underline-offset-4 transition-colors">
          Contactez-nous
        </a>
      </p>

    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-red-900/20 to-zinc-950">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-bold text-white mb-6">Un événement à capter ou à sonoriser ?</h2>
        <p class="text-xl text-zinc-300 mb-8">
          Dites-nous ce que vous préparez, nous vous répondons avec un devis sous 48 heures.
        </p>
        <a href="/contact"
           class="inline-block px-8 py-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg transition-all transform hover:scale-105">
          Demander un devis
        </a>
      </div>
    </div>
  </section>
  </main>

  <Footer />
</Layout>
