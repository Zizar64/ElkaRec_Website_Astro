---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /**
   * Passe la page en noindex, nofollow. Utilisé par /join, préparée mais
   * volontairement hors ligne tant que l'AG extraordinaire n'a pas modifié
   * l'article 14 des statuts.
   */
  noindex?: boolean;
  /**
   * JSON-LD additionnel, propre à la page : Service, FAQPage, BreadcrumbList.
   * Le LocalBusiness du site est déjà posé plus bas sur toutes les pages ;
   * ce paramètre sert à enrichir, pas à le remplacer.
   */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "ElkaRec - Association audiovisuelle et événementielle à Antony (92)",
  image = '/og-elkarec.jpg',
  noindex = false,
  schema,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Meta Robots -->
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="ElkaRec" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url).href} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#ef4444" />

    {/* Le logo affiché dans l'entête est une image traitée par Astro, servie
        sous un nom haché : il est déjà en fetchpriority="high" dans Header.astro.
        Le preload qui vivait ici visait /logo.webp, un fichier qui n'existait
        pas dans public/ — il déclenchait un 404 en haute priorité sur chaque
        page, et ne préchargeait rien. /logo.webp existe désormais, mais pour
        le JSON-LD, pas pour l'affichage : ne pas remettre de preload dessus. */}

    {/* Schema.org LocalBusiness

        Le type LocalBusiness, et non Organization : c'est lui qui alimente
        le référencement local, qui est le levier visé (Antony / 92).

        L'adresse doit rester STRICTEMENT identique, caractère pour
        caractère, à celle de la fiche Google Business Profile et du
        générateur de devis. Forme retenue : celle des statuts, « François
        Arago » sans trait d'union.

        La liste `areaServed` doit rester identique à la zone desservie
        déclarée dans la fiche Google Business Profile : c'est la cohérence
        entre les deux qui fait le signal local, pas leur contenu pris
        isolément. Référence :
        02_ELKAREC\05_COMMUNICATION\Fiche_Google_ElkaRec.html

        ⚠️ NE JAMAIS mettre de commentaire à l'intérieur du bloc JSON-LD
        ci-dessous. Astro n'interprète pas les commentaires JSX dans un
        script : il les émet tels quels, et le JSON devient invalide en
        silence. Aucun message d'erreur, le build passe, et le balisage est
        simplement ignoré par Google. Tout commentaire va ici, au-dessus de
        la balise. Éviter aussi d'écrire une balise HTML littérale dans ce
        commentaire, elle serait interprétée comme un vrai élément. */}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "ElkaRec",
        "description": "Association audiovisuelle et événementielle collégiale installée à Antony (92) : captation vidéo, streaming multicaméra et sonorisation d'événements",
        "url": "https://elkarec.fr",
        "logo": "https://elkarec.fr/logo.webp",
        "image": "https://elkarec.fr/logo.webp",
        "email": "contact@elkarec.fr",
        "priceRange": "€€",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "6 avenue François Arago",
          "postalCode": "92160",
          "addressLocality": "Antony",
          "addressRegion": "Île-de-France",
          "addressCountry": "FR"
        },
        "areaServed": [
          { "@type": "City", "name": "Antony" },
          { "@type": "City", "name": "Sceaux" },
          { "@type": "City", "name": "Bourg-la-Reine" },
          { "@type": "City", "name": "Fontenay-aux-Roses" },
          { "@type": "City", "name": "Châtenay-Malabry" },
          { "@type": "City", "name": "Le Plessis-Robinson" },
          { "@type": "City", "name": "Clamart" },
          { "@type": "City", "name": "Bagneux" },
          { "@type": "City", "name": "Montrouge" },
          { "@type": "City", "name": "Massy" },
          { "@type": "City", "name": "Verrières-le-Buisson" },
          { "@type": "City", "name": "Wissous" }
        ],
        "knowsAbout": [
          "Captation vidéo multicaméra",
          "Streaming en direct SRT et NDI",
          "Sonorisation d'événements",
          "Régie vidéo mobile",
          "Éclairage scénique",
          "Réemploi de matériel de diffusion professionnelle"
        ],
        "sameAs": [
          "https://www.youtube.com/@elkarec64",
          "https://fr.linkedin.com/company/elkarec-audiovisual-events",
          "https://www.facebook.com/elkarec/",
          "https://x.com/elka_rec",
          "https://www.instagram.com/elkarec/",
          "https://www.twitch.tv/elka_rec"
        ]
      }
    </script>

    {/* JSON-LD propre à la page : Service, FAQPage, BreadcrumbList.
        Voir la prop `schema` en tête de fichier. */}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased">
    <!-- Skip Navigation for Accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-red-500 focus:text-white focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400"
    >
      Aller au contenu principal
    </a>

    <slot />
  </body>
</html>
