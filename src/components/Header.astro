---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.webp';

// Le site sert DEUX publics, et le menu doit le montrer : « Services et
// tarifs » s'adresse aux clients, « L'association » et « Le local » aux
// futurs membres et bénévoles. Ne pas refusionner ces deux dernières dans
// l'accueil pour « simplifier » : c'est l'erreur corrigée le 22/08/2026,
// qui avait laissé un menu entièrement commercial.
//
// /join reste volontairement HORS de cette liste tant que l'assemblée
// générale extraordinaire n'a pas modifié l'article 14 des statuts.
const navItems = [
  { name: 'Accueil', href: '/' },
  { name: 'Services et tarifs', href: '/services/' },
  { name: 'Réalisations', href: '/realisations/' },
  { name: "L'association", href: '/association/' },
  { name: 'Le local', href: '/local/' },
  { name: 'Contact', href: '/contact/' },
];

// Le slash final n'est pas cosmétique ici : le serveur redirige /services
// vers /services/ en 308, et Astro.url.pathname vaut donc TOUJOURS la forme
// avec slash. Comparée à un href écrit sans slash, l'égalité était toujours
// fausse et aucune entrée de menu ne s'allumait, sauf l'accueil.
const currentPath = Astro.url.pathname;

// Une fiche de réalisation vit sous /realisations/<slug>/ : l'égalité stricte
// n'allumerait « Réalisations » que sur la page liste. On teste donc le
// préfixe, sauf pour l'accueil dont le chemin « / » préfixe tout le site.
const estActif = (href) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="fixed top-0 w-full z-50 bg-zinc-950/80 backdrop-blur-lg border-b border-zinc-800">
  <nav class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
        <Image
          src={logo}
          alt="ElkaRec"
          width={140}
          height={25}
          class="h-5 w-auto"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`text-sm font-medium transition-colors hover:text-red-400 ${
                estActif(item.href) ? 'text-red-400' : 'text-zinc-300'
              }`}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden text-zinc-300 hover:text-white"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <nav id="mobile-menu" class="hidden md:hidden mt-4 pb-4" aria-label="Navigation mobile">
      <ul class="flex flex-col gap-4">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`block text-sm font-medium transition-colors hover:text-red-400 ${
                estActif(item.href) ? 'text-red-400' : 'text-zinc-300'
              }`}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
    mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  });
</script>
